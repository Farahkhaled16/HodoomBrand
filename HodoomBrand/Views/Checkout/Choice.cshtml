@{
    ViewData["Title"] = "Checkout";
}

<div class="container py-5" style="max-width: 820px;">
    <h2 class="text-center mb-4">How would you like to check out?</h2>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="bg-white border p-4 h-100 text-center">
                <h5>Log in / Sign up</h5>
                <p class="text-muted">Track your order status, see all your orders, and cancel within the first hour.</p>
                <a class="btn btn-burgundy w-100 mb-2" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Checkout">Log in</a>
                <a class="btn btn-outline-burgundy w-100" asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="/Checkout">Create account</a>
            </div>
        </div>
        <div class="col-md-6">
            <div class="bg-white border p-4 h-100 text-center">
                <h5>Continue as guest</h5>
                <p class="text-muted">Quick checkout without an account. You will get a confirmation email, but you won't be able to track the order on the website.</p>
                <a class="btn btn-gold w-100" asp-action="Index" asp-route-guest="true">Continue as guest</a>
            </div>
        </div>
    </div>
</div>