@using Microsoft.Extensions.Configuration
@inject IConfiguration Config
@{
    var cartCount = HodoomBrand.Helpers.CartSession.Get(Context.Session).Sum(i => i.Quantity);
    var storeName = Config["Store:Name"] ?? "BORDO";
    var shipping = Config["Store:ShippingFee"] ?? "60";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @storeName</title>
    <link rel="icon" href="~/images/logo.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="top-bar">Flat shipping @shipping EGP to all governorates &nbsp;|&nbsp; Cash on delivery available</div>

    <nav class="navbar navbar-expand-lg site-nav sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.svg" alt="@storeName logo" />
                @storeName
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="AdminProducts" asp-action="Index">Products</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="AdminOrders" asp-action="Index">Orders</a></li>
                    }
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="Index">Shop</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
                </ul>
                <ul class="navbar-nav align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cart" asp-action="Index">Cart <span class="cart-badge">@cartCount</span></a>
                    </li>
                    <partial name="_LoginPartial" />
                </ul>
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5>@storeName</h5>
                    <p>Clothing with character. Deep colors, quality fabrics.</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h5>Links</h5>
                    <div><a asp-controller="Shop" asp-action="Index">Shop</a></div>
                    <div><a asp-controller="Home" asp-action="About">About us</a></div>
                    <div><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></div>
                </div>
                <div class="col-md-4 mb-3">
                    <h5>Contact</h5>
                    <div>@Config["Store:SupportEmail"]</div>
                    <div>Cash on delivery across Egypt</div>
                </div>
            </div>
            <div class="copy">&copy; @DateTime.Now.Year @storeName. All rights reserved.</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>