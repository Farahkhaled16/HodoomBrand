@model List<HodoomBrand.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="m-0">Products</h2>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-burgundy" asp-controller="AdminCategories" asp-action="Index">Categories</a>
            <a class="btn btn-burgundy" asp-action="Create">+ Add Product</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white">
            <thead>
                <tr><th></th><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var main = p.Media.FirstOrDefault(m => m.IsMain) ?? p.Media.FirstOrDefault(m => m.Type == HodoomBrand.Models.MediaType.Image);
                    <tr>
                        <td style="width:70px">
                            @if (main != null)
                            {
                                <img src="@main.FilePath" style="width:56px;height:70px;object-fit:cover;" alt="" />
                            }
                        </td>
                        <td>@p.Name</td>
                        <td>@p.Category?.Name</td>
                        <td>
                            @if (p.DiscountPrice.HasValue)
                            {
                                <span>@p.DiscountPrice.Value.ToString("0.##") EGP</span>
                                <small class="text-muted text-decoration-line-through">@p.Price.ToString("0.##")</small>
                            }
                            else
                            {
                                <span>@p.Price.ToString("0.##") EGP</span>
                            }
                        </td>
                        <td>@p.StockQuantity</td>
                        <td>@(p.IsActive ? "Visible" : "Hidden")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-burgundy" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this product and all its images/videos?');">
                                <button class="btn btn-sm btn-outline-burgundy" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted text-center">No products yet. Add a category first, then add your first product.</p>
    }
</div>