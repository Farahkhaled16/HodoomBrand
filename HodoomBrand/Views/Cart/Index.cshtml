@using Microsoft.Extensions.Configuration
@inject IConfiguration Config
@model List<HodoomBrand.Models.CartItem>
@{
    ViewData["Title"] = "Cart";
    var shipping = decimal.Parse(Config["Store:ShippingFee"] ?? "60");
    var subtotal = Model.Sum(i => i.LineTotal);
    var total = Model.Any() ? subtotal + shipping : 0;
}

<div class="container py-5">
    <h2 class="mb-4">Your Cart</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <p class="text-muted">Your cart is empty.</p>
        <a class="btn btn-burgundy" asp-controller="Shop" asp-action="Index">Continue shopping</a>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle bg-white">
                <thead><tr><th></th><th>Item</th><th>Price</th><th>Qty</th><th>Total</th><th></th></tr></thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        <tr>
                            <td style="width:70px">
                                @if (i.Image != null)
                                {
                                    <img src="@i.Image" style="width:56px;height:70px;object-fit:cover;" alt="" />
                                }
                            </td>
                            <td>
                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@i.ProductId">@i.Name</a>
                                <div class="small text-muted">
                                    @if (!string.IsNullOrEmpty(i.Size))
                                    {
                                        <span>Size: @i.Size</span>
                                    }
                                    @if (!string.IsNullOrEmpty(i.Color))
                                    {
                                        <span> | Color: @i.Color</span>
                                    }
                                </div>
                            </td>
                            <td>@i.UnitPrice.ToString("0.##") EGP</td>
                            <td>
                                <form asp-action="Update" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="key" value="@i.Key" />
                                    <input type="number" name="quantity" value="@i.Quantity" min="0" class="form-control form-control-sm" style="width:70px" />
                                    <button class="btn btn-sm btn-outline-burgundy" type="submit">Update</button>
                                </form>
                            </td>
                            <td>@i.LineTotal.ToString("0.##") EGP</td>
                            <td>
                                <form asp-action="Remove" method="post">
                                    <input type="hidden" name="key" value="@i.Key" />
                                    <button class="btn btn-sm btn-outline-burgundy" type="submit">&times;</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row justify-content-end">
            <div class="col-md-5">
                <div class="bg-white border p-4">
                    <div class="d-flex justify-content-between"><span>Subtotal</span><span>@subtotal.ToString("0.##") EGP</span></div>
                    <div class="d-flex justify-content-between"><span>Shipping</span><span>@shipping.ToString("0.##") EGP</span></div>
                    <hr />
                    <div class="d-flex justify-content-between fw-semibold fs-5"><span>Total</span><span>@total.ToString("0.##") EGP</span></div>
                    <a class="btn btn-gold w-100 mt-3" asp-controller="Checkout" asp-action="Index">Checkout</a>
                </div>
            </div>
        </div>

        <div class="mt-3"><a asp-controller="Shop" asp-action="Index">&larr; Continue shopping</a></div>
    }
</div>